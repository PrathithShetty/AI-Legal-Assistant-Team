# Copy this file to .env and fill in the values. Never commit .env to Git.

# Long random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First administrator account, created automatically when the app starts.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: Claude API key for AI-written summaries (https://console.anthropic.com).
# Leave empty to answer from the built-in legal knowledge base only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=30

# Production only: redirect HTTP to HTTPS and use secure cookies.
FORCE_HTTPS=0
